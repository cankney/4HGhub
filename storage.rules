rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{userId}/{fileName} {
      // Owners can read/write their receipts. Cole/Admins can read/delete all.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'cole@4hgs.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*@4hgs\\.com$"))
      );
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'cole@4hgs.com'
      );
    }
  }
}
